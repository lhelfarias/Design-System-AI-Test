    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@storybook/addon-a11y": "10.6",
    "@storybook/react-vite": "10.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "storybook": "10.6",
    "typescript": "~5.9",
    "vite": "^8.3.8"
  }
}
