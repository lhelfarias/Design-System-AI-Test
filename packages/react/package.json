{
  "name": "@mi-design-system/react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React components for the design system, styled only with the CSS variables from packages/tokens",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
